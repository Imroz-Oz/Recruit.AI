{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Company or Agency entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended", "trial"] },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId"]
    },
    "User": {
      "title": "User Profile",
      "description": "User account and settings with multi-tenant support",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["recruiter", "candidate"] },
        "userLevel": { "type": "string", "enum": ["member", "admin", "superadmin"] },
        "organizationId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Candidate in an organization's internal pool",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "recruiterId": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "score": { "type": "number" },
        "experience": { "type": "number" },
        "resumeUrl": { "type": "string" },
        "resumeHash": { "type": "string" },
        "isValidResume": { "type": "boolean" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "organizationId", "name"]
    },
    "AIInteraction": {
      "title": "AI Interaction",
      "description": "Record of AI usage and user feedback for learning",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "originalPrompt": { "type": "string" },
        "output": { "type": "string" },
        "userEdit": { "type": "string" },
        "userRating": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organization details"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/organizations/{orgId}/candidates/{candidateId}": {
      "schema": "Candidate",
      "description": "Organization-specific talent pool"
    },
    "/organizations/{orgId}/jobs/{jobId}": {
      "schema": "Job",
      "description": "Organization job postings"
    },
    "/interactions/{interactionId}": {
      "schema": "AIInteraction",
      "description": "AI learning data"
    }
  }
}
